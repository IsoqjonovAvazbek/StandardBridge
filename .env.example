# StandardBridge muhit o'zgaruvchilari namunasi.
# Bu faylni `.env` ga nusxalang va haqiqiy qiymatlarni kiriting:
#   cp .env.example .env

# --- AI (Groq) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
AI_TIMEOUT=45    # Groq javob kutish vaqti (soniya)

# --- Django ---
SECRET_KEY=django-insecure-CHANGE-ME-random-50-chars
DEBUG=True
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# SECURE_SSL_REDIRECT=True  # Production HTTPS uchun

# --- Baza ---
# Bo'sh qoldirsangiz lokal SQLite ishlatiladi.
# Production (Postgres) uchun: DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=

# --- Email (Gmail SMTP, App Password) ---
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# --- Karta raqamini shifrlash (Fernet) ---
# Kalit generatsiya: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production uchun MAJBURIY — o'rnatilmasa tizim ishga tushmaydi
FERNET_KEY=

# --- Telegram Bot ---
# 1. @BotFather ga /newbot yozing → token oling
# 2. Bot username (@ belgisisiz): masalan StandardBridgeBot
# 3. Webhook o'rnatish (Railway deploy qilingandan keyin):
#    curl -F "url=https://SAYT_URL/accounts/telegram/webhook/" \
#         -F "secret_token=TELEGRAM_WEBHOOK_SECRET" \
#         https://api.telegram.org/botTELEGRAM_BOT_TOKEN/setWebhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=my-random-secret-string

# --- Click to'lov (my.click.uz dan) ---
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=http://127.0.0.1:8000

# --- Google Analytics 4 ---
# analytics.google.com → Admin → Data Streams → Measurement ID (G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=

# --- Cloudinary (Media fayllarni doimiy saqlash uchun) ---
# 1. cloudinary.com da bepul hisob oching
# 2. Dashboard → "API Keys" → Cloud name, API Key, API Secret
# Bo'sh qoldirsangiz lokal disk ishlatiladi (Railway da restart bo'lsa fayllar o'chadi)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
