# StandardBridge muhit o'zgaruvchilari namunasi.
# Bu faylni `.env` ga nusxalang va haqiqiy qiymatlarni kiriting:
#   cp .env.example .env

# --- AI (Groq) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
AI_TIMEOUT=45    # Groq javob kutish vaqti (soniya)

# --- Django ---
SECRET_KEY=django-insecure-CHANGE-ME-random-50-chars
DEBUG=True
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# SECURE_SSL_REDIRECT=True  # Production HTTPS uchun

# --- Baza ---
# Bo'sh qoldirsangiz lokal SQLite ishlatiladi.
# Production (Postgres) uchun: DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=

# --- Email (Gmail SMTP, App Password) ---
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# --- Karta raqamini shifrlash (Fernet) ---
# Kalit generatsiya: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production uchun MAJBURIY — o'rnatilmasa tizim ishga tushmaydi
FERNET_KEY=

# --- Click to'lov (my.click.uz dan) ---
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_RETURN_URL=http://127.0.0.1:8000
